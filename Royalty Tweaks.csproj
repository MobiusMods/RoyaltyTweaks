<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds against RimWorld 1.7, which runs on its own .NET 10 runtime. There is no
    reference pack for that runtime, so the framework comes from the game's own
    System.*.dll files instead of the SDK. Override RimWorldDir / HarmonyDir if the
    game or the Harmony Workshop mod lives somewhere else.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Royalty Tweaks</AssemblyName>
    <RootNamespace>Mobius.RoyaltyTweaks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoWarn>$(NoWarn);CS1705</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld\</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Release\**;packages\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(RimWorldDir)System*.dll;$(RimWorldDir)netstandard.dll;$(RimWorldDir)mscorlib.dll" Exclude="$(RimWorldDir)System.IO.Compression.Native.dll" Private="false" />
    <Reference Include="$(RimWorldDir)Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(RimWorldDir)UnityStubs.dll" Private="false" />
    <Reference Include="$(HarmonyDir)0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
